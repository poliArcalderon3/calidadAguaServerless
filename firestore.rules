rules_version = '2';

// El navegador nunca lee Firestore directamente: todo pasa por las funciones serverless de /api,
// que usan el SDK de administrador con una cuenta de servicio (no les aplican estas reglas).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
